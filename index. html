<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>بطاقة دعوة عقد قران مزخرفة</title>
    <!-- استدعاء خطوط عربية مزخرفة وأنيقة من جوجل -->
    <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Reem+Kufi:wght@500;700&display=swap" rel="stylesheet">
    <!-- مكتبة تحويل البطاقة إلى صورة -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <style>
        body {
            font-family: 'Amiri', serif;
            background-color: #fcfbfa;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            background: #fff;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }
        h2 {
            color: #d4af37;
            text-align: center;
            border-bottom: 2px solid #f3ebd8;
            padding-bottom: 10px;
            margin-bottom: 20px;
            font-family: 'Reem Kufi', sans-serif;
        }
        .form-section {
            background: #fdfcf9;
            padding: 15px;
            border-radius: 8px;
            border: 1px solid #e6dec9;
            margin-bottom: 25px;
            font-family: 'Tahoma', sans-serif;
        }
        .form-section h3 {
            margin-top: 0;
            color: #b89728;
            font-size: 16px;
        }
        label {
            display: block;
            margin-top: 10px;
            font-weight: bold;
            color: #555;
            font-size: 13px;
        }
        input, textarea {
            width: 100%;
            padding: 8px;
            margin-top: 5px;
            border: 1px solid #d4af37;
            border-radius: 5px;
            box-sizing: border-box;
            background: #fff;
            font-family: 'Amiri', serif;
            font-size: 16px;
        }
        
        /* تصميم البطاقة الفاخرة بالإطار الفضي والنصوص الذهبية */
        .card-preview {
            background: linear-gradient(135deg, #fffefc 0%, #f9f7f2 100%);
            /* مربع محيط بالبطاقة فضي اللون ومزدوج وفخم */
            border: 5px double #c0c0c0;
            padding: 45px 30px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
            position: relative;
        }
        
        /* إطار داخلي فضي إضافي لتعزيز الجمال */
        .card-preview::before {
            content: "";
            position: absolute;
            top: 12px;
            right: 12px;
            bottom: 12px;
            left: 12px;
            border: 1px solid #dcdcdc;
            border-radius: 10px;
            pointer-events: none;
        }

        .floral-ornament {
            font-size: 24px;
            color: #d4af37;
            margin: 10px 0;
            letter-spacing: 4px;
        }

        .card-preview h1, .card-preview p {
            color: #444;
            font-size: 19px;
            line-height: 1.9;
            margin: 12px 0;
        }

        .gold-text {
            color: #c59b27; /* لون ذهبي دافئ وناعم */
            font-weight: bold;
            text-shadow: 0px 1px 1px rgba(212, 175, 55, 0.2);
        }

        /* تنسيق أسماء العروسين بالخط المزخرف والذهبي مع القلب الأحمر */
        .names {
            font-size: 32px;
            font-weight: bold;
            color: #c59b27;
            margin: 25px 0;
            font-family: 'Amiri', serif;
            letter-spacing: 1px;
        }
        
        .heart {
            color: #e74c3c; /* قلب أحمر بارز */
            display: inline-block;
            margin: 0 10px;
            font-size: 28px;
            vertical-align: middle;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.15); }
            100% { transform: scale(1); }
        }

        .details-box {
            background: rgba(255, 255, 255, 0.9);
            padding: 18px 25px;
            border-radius: 10px;
            display: inline-block;
            margin-top: 15px;
            border: 1px solid #e0d5b5;
            box-shadow: 0 3px 10px rgba(0,0,0,0.03);
            text-align: right;
        }
        .details-box p {
            margin: 6px 0;
            font-size: 17px;
            color: #555;
        }

        .btn {
            background-color: #d4af37;
            color: white;
            padding: 12px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            width: 100%;
            font-size: 18px;
            font-weight: bold;
            font-family: 'Reem Kufi', sans-serif;
            margin-top: 25px;
            transition: 0.3s;
            box-shadow: 0 4px 10px rgba(212, 175, 55, 0.3);
        }
        .btn:hover {
            background-color: #b89728;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>مصمم بطاقات دعوة عقد القران المزخرفة</h2>

    <!-- حقول الإدخال -->
    <div class="form-section">
        <h3>أدخل تفاصيل الحفل:</h3>
        <label>الآية أو المقدمة:</label>
        <textarea id="inIntro" rows="2" oninput="updateCard()">"وَمِنْ آيَاتِهِ أَنْ خَلَقَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَاجاً لِّتَسْكُنُوا إِلَيْهَا وَجَعَلَ بَيْنَكُم مَّوَدَّةً وَرَحْمَةً"</textarea>

        <label>اسم العريس:</label>
        <input type="text" id="inGroom" value="محمد" oninput="updateCard()">

        <label>اسم العروس:</label>
        <input type="text" id="inBride" value="فاطمة" oninput="updateCard()">

        <label>تاريخ الحفل:</label>
        <input type="text" id="inDate" value="الجمعة، 15 / ذو القعدة / 2026" oninput="updateCard()">

        <label>وقت الحفل:</label>
        <input type="text" id="inTime" value="الساعة الثامنة مساءً" oninput="updateCard()">

        <label>مكان الحفل (الصالة أو العنوان):</label>
        <input type="text" id="inLocation" value="صالة الأوسكار - استراحة المحافظة" oninput="updateCard()">
    </div>

    <!-- البطاقة البصرية المزخرفة (المعاينة الحية) -->
    <div class="card-preview" id="weddingCard">
        <div class="floral-ornament">✧ 🌿 ✧ 💐 ✧ 🌿 ✧</div>
        
        <p style="font-style: italic;" class="gold-text" id="outIntro">"وَمِنْ آيَاتِهِ أَنْ خَلَقَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَاجاً لِّتَسْكُنُوا إِلَيْهَا وَجَعَلَ بَيْنَكُم مَّوَدَّةً وَرَحْمَةً"</p>
        
        <p style="margin-top: 20px;">ببالغ السرور والبهجة، نتشرف بدعوتكم لحضور حفل عقد القران المبارك</p>
        
        <div class="names">
            <span id="outGroom" class="gold-text">محمد</span><span class="heart">❤️</span><span id="outBride" class="gold-text">فاطمة</span>
        </div>

        <div class="details-box">
            <p>📅 <strong class="gold-text">التاريخ:</strong> <span id="outDate">الجمعة، 15 / ذو القعدة / 2026</span></p>
            <p>⏰ <strong class="gold-text">الوقت:</strong> <span id="outTime">الساعة الثامنة مساءً</span></p>
            <p>📍 <strong class="gold-text">المكان:</strong> <span id="outLocation">صالة الأوسكار - استراحة المحافظة</span></p>
        </div>

        <p style="margin-top: 22px; font-weight: bold;" class="gold-text">حضوركم يكتمل به فرحنا، وبكم تشرق أنوارنا</p>
        
        <div class="floral-ornament">✧ 🌿 ✧ 💐 ✧ 🌿 ✧</div>
    </div>

    <!-- زر التحميل -->
    <button class="btn" onclick="downloadCardImage()">📥 تحميل البطاقة المزخرفة كصورة جاهزة للإرسال</button>
</div>

<script>
    function updateCard() {
        document.getElementById('outIntro').innerText = document.getElementById('inIntro').value;
        document.getElementById('outGroom').innerText = document.getElementById('inGroom').value;
        document.getElementById('outBride').innerText = document.getElementById('inBride').value;
        document.getElementById('outDate').innerText = document.getElementById('inDate').value;
        document.getElementById('outTime').innerText = document.getElementById('inTime').value;
        document.getElementById('outLocation').innerText = document.getElementById('inLocation').value;
    }

    function downloadCardImage() {
        const cardElement = document.getElementById('weddingCard');
        html2canvas(cardElement, { scale: 2 }).then(canvas => {
            let link = document.createElement('a');
            link.download = 'wedding-invitation-gold.png';
            link.href = canvas.toDataURL('image/png');
            link.click();
        });
    }
</script>

</body>
</html>
